# ============================================
# LLM-Powered SOC Analyst Configuration
# ============================================

# Gemini API (Primary LLM)
GEMINI_API_KEY=your-gemini-key-here

# Ollama Configuration (Fallback)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENROUTER_MODEL=qwen3:4b
OPENAI_API_KEY=ollama

# ============================================
# Application Settings
# ============================================

# Debug mode (true/false)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# JWT Secret (change this in production!)
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production

# ============================================
# Database Configuration
# ============================================

# ChromaDB settings
CHROMA_DB_PATH=./vector_db

# ============================================
# LSTM Model Settings
# ============================================

# Path to pre-trained LSTM model
LSTM_MODEL_PATH=./models/lstm_anomaly.pt

# ============================================
# Feature Flags
# ============================================

# Enable agent correlation layer
ENABLE_AGENT_LAYER=true

# Enable threat intelligence enrichment
ENABLE_THREAT_INTEL=true

# Enable RAG (MITRE ATT&CK retrieval)
ENABLE_RAG=true

# ============================================
# Server Settings
# ============================================

# API Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# CORS settings
CORS_ORIGINS=*
ALLOW_CREDENTIALS=true

# ============================================
# Demo Credentials (Change in Production!)
# ============================================

# Demo users for JWT authentication
DEMO_USERS=analyst:password123,admin:admin123,soc_team:team123
