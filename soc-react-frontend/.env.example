# ─── SOC React Frontend — Environment Variables ───────────────────────────────
#
# Copy this file to .env.local for local development overrides.
# On Vercel, set these in: Project Settings → Environment Variables
#
# ──────────────────────────────────────────────────────────────────────────────

# Your deployed FastAPI backend URL (no trailing slash).
# Examples:
#   https://your-soc-api.railway.app
#   https://your-soc-api.render.com
#   https://your-soc-api.fly.dev
VITE_API_BASE=https://your-backend-url-here.com
